# Copy to docker-compose/.env and pass it with --env-file.
# Match this tag to images built/published from the intended source revision.
# Current Maven Jib targets use 1.0.0; a JAR build alone does not update images.
AIRLINE_IMAGE_TAG=1.0.0
STRIPE_API_KEY=
STRIPE_CALLBACK_BASE_URL=http://localhost:5173
CONFIG_GIT_URI=https://github.com/hduong02/airline-system-config.git

# MailHog defaults capture mail at http://localhost:8025.
# For an external SMTP provider, also set authentication/TLS as required.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=notifications@airlines.test
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
