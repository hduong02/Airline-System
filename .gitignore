# ==========================================
# Spring Boot / Maven .gitignore
# ==========================================

# ---- Maven ----
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---- IDE: IntelliJ IDEA ----
.idea/
*.iws
*.iml
*.ipr
out/

# ---- IDE: Eclipse ----
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ---- IDE: VS Code ----
.vscode/

# ---- IDE: NetBeans ----
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ---- Spring Boot ----
spring-shell.log
*.log
logs/

# ---- Java ----
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---- OS Generated ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Environment / Secrets ----
*.env
.env
.env.*
!.env.example
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties

# ---- Docker ----
docker-compose.override.yml

# ---- Misc ----
# pnpm dependency cache
.pnpm-store/

*.tmp
*.bak
*.swp
*~.nib
